{
  "name": "black-sepulchre-campaign",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "dev": "npm run rules && vite",
    "build": "node tools/compile-rules.mjs && tsc -p tsconfig.engine.json && tsc -b && vite build && node tools/build-assets.mjs",
    "preview": "vite preview",
    "test": "node tools/compile-rules.mjs && tsx --test tests/*.test.ts",
    "rules": "node tools/compile-rules.mjs",
    "test:e2e:prepare": "node tools/e2e-local.mjs",
    "test:e2e": "node tools/run-e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
